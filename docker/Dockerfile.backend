# VIPClaw Backend Dockerfile - Single Stage Build
# Uses locally built JAR package, no compilation inside Docker

FROM eclipse-temurin:21-jre

# Set timezone
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Create non-root user
RUN groupadd -r vipclaw && useradd -r -g vipclaw vipclaw

WORKDIR /app

# Copy JAR file from docker/dist/backend/
COPY docker/dist/backend/vipclaw-admin-*.jar app.jar

# Create log directory and set permissions
RUN mkdir -p /app/logs && chown -R vipclaw:vipclaw /app

# Switch to non-root user
USER vipclaw

# Expose port
EXPOSE 8080

# Health check (using wget, eclipse-temurin includes wget)
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD wget -qO- http://localhost:8080/api/health || exit 1

# JVM options optimization
ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs"

# Start application
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]

# Metadata
LABEL maintainer="vipamp"
LABEL version="1.0.0"
LABEL description="VIPClaw Admin Backend"
