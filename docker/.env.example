# Harnax Docker Environment Variables
# Copy this file to .env and customize as needed

# MySQL Configuration
MYSQL_DATA_DIR=./data/mysql

# Database Connection
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/harnax?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=harnax
SPRING_DATASOURCE_PASSWORD=harnax123

# Session Database (optional, defaults to main database if not set)
SESSION_JDBC_URL=jdbc:mysql://mysql:3306/harnax?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SESSION_DATABASE_NAME=harnax
SESSION_USERNAME=harnax
SESSION_PASSWORD=harnax123

# Application Settings
SPRING_PROFILES_ACTIVE=personal
LOCAL_TMP_DIR=/tmp
LOG_LEVEL=DEBUG

# Router Service
HARNAX_AUTH_SECRET=change-me-in-production-min-32-chars!!
ADMIN_INTERNAL_API_SECRET=change-me-in-production-min-32-chars!!

# Edition (personal, enterprise, public)
EDITION=personal
