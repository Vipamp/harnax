# VIPClaw Docker Environment Variables
# Copy this file to .env and customize as needed

# MySQL Configuration
MYSQL_DATA_DIR=./data/mysql
MYSQL_INIT_DIR=./init

# Database Connection
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/vipclaw?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=vipclaw
SPRING_DATASOURCE_PASSWORD=vipclaw123

# Session Database (optional, defaults to main database if not set)
# SESSION_JDBC_URL=jdbc:mysql://mysql:3306/vipclaw?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# SESSION_DATABASE_NAME=vipclaw
# SESSION_USERNAME=vipclaw
# SESSION_PASSWORD=vipclaw123

# Application Settings
SPRING_PROFILES_ACTIVE=personal
LOG_LEVEL=DEBUG

# Edition (personal, enterprise, public)
EDITION=personal
