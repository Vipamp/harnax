# Harnax Router Dockerfile - Single Stage Build
# Uses locally built JAR package, no compilation inside Docker
# Session routing service with cluster mode support (MySQL + Redis)

FROM eclipse-temurin:21-jre-alpine

# Set timezone (use Aliyun mirror for Alpine packages)
ENV TZ=Asia/Shanghai
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories \
    && apk add --no-cache tzdata wget \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone

# Create non-root user
RUN addgroup -S harnax && adduser -S harnax -G harnax

WORKDIR /app

# Copy JAR file from docker-new/dist/router/
COPY docker-new/dist/router/harnax-session-router-*.jar app.jar

# Create log directory and set permissions
RUN mkdir -p /app/logs && chown -R harnax:harnax /app

# Switch to non-root user
USER harnax

# Expose port
EXPOSE 8081

# Health check — /api/router/health needs an internal JWT, so a probe there would read 401 and
# mark a perfectly routing-enabled container unhealthy. Liveness is anonymous, like every other image.
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD wget -qO- http://localhost:8081/actuator/health/liveness || exit 1

# JVM options optimization
ENV JAVA_OPTS="-Xms128m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+UseStringDeduplication -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs"

# Start application
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]

# Metadata
LABEL maintainer="agnetix"
LABEL version="1.0.0"
LABEL description="Harnax Session Router"
