# Harnax Admin Dockerfile - Single Stage Build
# Uses locally built JAR package, no compilation inside Docker

FROM eclipse-temurin:21-jre-alpine

# Set timezone (use Aliyun mirror for Alpine packages)
ENV TZ=Asia/Shanghai
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories \
    && apk add --no-cache tzdata wget \
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime \
    && echo $TZ > /etc/timezone

# Create non-root user
RUN addgroup -S harnax && adduser -S harnax -G harnax

WORKDIR /app

# Copy JAR file from docker-new/dist/harnax-admin/
COPY docker-new/dist/harnax-admin/harnax-admin-*.jar app.jar

# Create log directory, skill storage directory and set permissions
RUN mkdir -p /app/logs /home/harnax/skills && chown -R harnax:harnax /app /home/harnax

# Switch to non-root user
USER harnax

# Expose port
EXPOSE 8080

# Health check (using wget, eclipse-temurin includes wget)
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD wget -qO- http://localhost:8080/api/health || exit 1

# JVM options optimization
ENV JAVA_OPTS="-Xms128m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+UseStringDeduplication -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs"

# Start application
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]

# Metadata
LABEL maintainer="agnetix"
LABEL version="1.0.0"
LABEL description="Harnax Admin"
