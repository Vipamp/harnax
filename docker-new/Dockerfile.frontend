# Harnax Frontend Dockerfile - Single Stage Build
# Uses locally built static files, no Node.js build inside Docker

FROM nginx:alpine

# Install wget for health check (use Aliyun mirror)
#
# GNU wget, not the BusyBox applet already in the base image: `nginx:alpine` binds the IPv4 socket only, and
# BusyBox wget takes the first address it is handed without falling back, so `http://localhost/health` —
# what both health checks here ask for — would be reported as a connection refused.
#
# The mirror is a convenience, not a dependency: deploy-all.sh builds with --no-cache so this layer is
# re-fetched on every deploy, and a single I/O blip on the mirror used to abort the whole run before the
# backend images had been swapped. Fall back to the upstream CDN instead.
RUN sed -i 's|dl-cdn.alpinelinux.org|mirrors.aliyun.com|g' /etc/apk/repositories \
    && apk add --no-cache wget \
    || { sed -i 's|mirrors.aliyun.com|dl-cdn.alpinelinux.org|g' /etc/apk/repositories && apk add --no-cache wget; }

# Copy Nginx configuration
COPY docker-new/nginx.conf /etc/nginx/conf.d/default.conf

# Copy frontend static files from docker-new/dist/frontend/
COPY docker-new/dist/frontend/ /usr/share/nginx/html/

# Create SSL directory for certificate mount
RUN mkdir -p /etc/nginx/ssl

# Set proper permissions
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Expose ports. Nginx listens on the standard 80 / 443 inside the container — see
# docker-new/nginx.conf — and docker-compose publishes them 1:1 on the host.
EXPOSE 80 443

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost/health || exit 1

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]

# Metadata
LABEL maintainer="harnax"
LABEL version="1.0.0"
LABEL description="Harnax Frontend"
