# Harnax Frontend Dockerfile - Single Stage Build
# Uses locally built static files, no Node.js build inside Docker

FROM nginx:alpine

# Install wget for health check (use Aliyun mirror)
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories \
    && apk add --no-cache wget

# Copy Nginx configuration
COPY docker-new/nginx.conf /etc/nginx/conf.d/default.conf

# Copy frontend static files from docker-new/dist/frontend/
COPY docker-new/dist/frontend/ /usr/share/nginx/html/

# Create SSL directory for certificate mount
RUN mkdir -p /etc/nginx/ssl

# Set proper permissions
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Expose ports (HTTP for health check, HTTPS for traffic)
EXPOSE 80 443

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:80/ || exit 1

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]

# Metadata
LABEL maintainer="harnax"
LABEL version="1.0.0"
LABEL description="Harnax Frontend"
