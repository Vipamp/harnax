# =====================================================
# Harnax Docker Environment Variables (Example)
# Cluster Mode Deployment
#
# Copy this file to .env and customize for your environment:
#   cp .env.example .env
# =====================================================

# === Infrastructure ===
# MySQL root password (used for initial setup only)
MYSQL_ROOT_PASSWORD=root123456
# MySQL data directory (persistent storage)
MYSQL_DATA_DIR=./data/mysql

# === Database ===
# Application database user (created by init-databases.sql)
DB_USERNAME=harnax
DB_PASSWORD=<your-secure-password-here>

# === Session Database ===
# Session database name (defaults to harnax if not set)
SESSION_DB_NAME=harnax

# === Auth Secrets ===
# JWT signing secret (minimum 32 characters, must be same across all services)
JWT_SECRET=<your-jwt-secret-min-32-chars>
# Internal API authentication secret (used by router/agent/channel to call admin)
ADMIN_INTERNAL_API_SECRET=<your-internal-api-secret-min-32-chars>
# Unified auth secret (used by router/agent/channel for inter-service auth)
HARNAX_AUTH_SECRET=<your-auth-secret-min-32-chars>
# 注意：router 以 redis 模式启动时会校验上面两个值，仍是 compose 兜底的占位值就直接拒绝启动。

# === MinIO ===
# MinIO object storage credentials (used for sandbox snapshots)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=<your-minio-secret>

# === Router (Cluster Mode) ===
# Router instance ID (unique per router instance in cluster)
ROUTER_SERVICE_ID=router-0

# === Agent Service ===
# Agent service instance ID (unique per agent instance)
AGENT_INSTANCE_ID=agent-service-1

# === Channel Service ===
# Channel service instance ID
CHANNEL_SERVICE_ID=channel-0

# Router API Key。留空时服务启动会向 admin 申请一个系统 key，admin 不可达则启动失败；
# 显式配置可以去掉这个启动依赖。
#CHANNEL_API_KEY=

# Every tunable below already defaults to the value shown in docker-compose.yml;
# uncomment only what you need to change.
#
# Listener ownership. Long-lived channel connections (Feishu/WeChat/DingTalk/WeCom) must be
# driven by exactly one instance, otherwise the same inbound message is consumed several times.
# This is enforced with a MySQL GET_LOCK mutex, and the other replicas idle as hot standbys.
# Only set this to false when you deliberately run a sharded listener deployment.
#CHANNEL_LOCK_ENABLED=true
#CHANNEL_LOCK_NAME=harnax-channel-listeners
#
# 一轮 reconcile 可以启动多少个监听器，以及重启一个已死监听器的等待时间
# （退避从 initial 增长到上限，该上限同时是“曾经健康足够久”的重置阈值）。
#CHANNEL_SYNC_INTERVAL_MS=10000
#CHANNEL_SYNC_MAX_STARTS=5
#CHANNEL_RESTART_BACKOFF_INITIAL_MS=2000
#CHANNEL_RESTART_BACKOFF_MAX_MS=300000
#CHANNEL_STALE_HEARTBEAT_MS=180000
#
# Inbound message processing. Bounded thread pool with a per-channel concurrency cap and
# per-session serialization, so one slow channel cannot exhaust the pool for the others.
#CHANNEL_TURN_POOL_SIZE=24
#CHANNEL_TURN_PER_CHANNEL=4
#
# In-memory conversation cache (LRU + idle TTL). Raise max-sessions only with heap headroom.
#CHANNEL_SESSION_MAX_SESSIONS=10000
#CHANNEL_SESSION_MAX_MESSAGES=500
#CHANNEL_SESSION_IDLE_TTL_MIN=120
#
# Router call protection: the breaker opens after this many consecutive failures and probes
# again after the open duration. stream-idle cancels an SSE stream that stops emitting.
#ROUTER_BREAKER_ENABLED=true
#ROUTER_BREAKER_FAILURE_THRESHOLD=5
#ROUTER_BREAKER_OPEN_DURATION_MS=30000
#CHANNEL_STREAM_IDLE_TIMEOUT_MS=180000
#
# 连接健康指示器（/actuator/health）。与上面的容器存活探针互不影响：平台连接断开只是服务降级，
# 不该因此重启容器。failure-grace 是一个频道持续 FAILED 多久后整体状态才转 DOWN。
#CHANNEL_HEALTH_ENABLED=true
#CHANNEL_HEALTH_FAILURE_GRACE_MS=60000

# === Application Settings ===
# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Public origin of this deployment, passed to admin as Spring's `app.base-url`. It is the prefix used
# to build channel platform callbacks. Use the address the upstream can actually reach (the nginx
# front door when there is one), with no trailing slash.
APP_BASE_URL=http://localhost

# Origin the browser is standing on, read as Spring's `app.frontend-base-url`. The MCP OAuth
# redirect_uri is built from it and is a front-end route, so behind nginx this is the same address as
# APP_BASE_URL; left empty it falls back to APP_BASE_URL. OAuth compares redirect_uri against the
# registered value as an exact string, so a wrong value here makes the first authorization attempt
# fail at the authorization server.
APP_FRONTEND_BASE_URL=http://localhost
