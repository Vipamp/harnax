# =====================================================
# Harnax Docker Environment Variables (Example)
# Cluster Mode Deployment
#
# Copy this file to .env and customize for your environment:
#   cp .env.example .env
# =====================================================

# === Infrastructure ===
# MySQL root password (used for initial setup only)
MYSQL_ROOT_PASSWORD=root123456
# MySQL data directory (persistent storage)
MYSQL_DATA_DIR=./data/mysql

# === Database ===
# Application database user (created by init-databases.sql)
DB_USERNAME=harnax
DB_PASSWORD=<your-secure-password-here>

# === Session Database ===
# Session database name (defaults to harnax if not set)
SESSION_DB_NAME=harnax

# === Auth Secrets ===
# JWT signing secret (minimum 32 characters, must be same across all services)
JWT_SECRET=<your-jwt-secret-min-32-chars>
# Internal API authentication secret (used by router/agent/channel to call admin)
ADMIN_INTERNAL_API_SECRET=<your-internal-api-secret-min-32-chars>
# Unified auth secret (used by router/agent/channel for inter-service auth)
HARNAX_AUTH_SECRET=<your-auth-secret-min-32-chars>

# === MinIO ===
# MinIO object storage credentials (used for sandbox snapshots)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=<your-minio-secret>

# === Router (Cluster Mode) ===
# Router instance ID (unique per router instance in cluster)
ROUTER_SERVICE_ID=router-0

# === Agent Service ===
# Agent service instance ID (unique per agent instance)
AGENT_INSTANCE_ID=agent-service-1

# === Channel Service ===
# Channel service instance ID
CHANNEL_SERVICE_ID=channel-0

# === Application Settings ===
# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
