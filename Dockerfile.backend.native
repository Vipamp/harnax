# VIPClaw 后端 Native Dockerfile - 多阶段构建
# Stage 1: 使用 Maven + GraalVM 构建原生镜像
FROM maven:3.9-eclipse-temurin-21 AS builder

ARG EDITION=personal
ENV EDITION_CURRENT=${EDITION}

WORKDIR /app

# 复制 Maven 包装器和 pom 文件
COPY pom.xml .
COPY vipclaw-common/pom.xml vipclaw-common/
COPY vipclaw-agent/pom.xml vipclaw-agent/
COPY vipclaw-channel/pom.xml vipclaw-channel/
COPY vipclaw-admin/pom.xml vipclaw-admin/

# 下载依赖(利用 Docker 缓存)
RUN mvn dependency:go-offline -B || true

# 复制源代码
COPY vipclaw-common/ vipclaw-common/
COPY vipclaw-agent/ vipclaw-agent/
COPY vipclaw-channel/ vipclaw-channel/
COPY vipclaw-admin/ vipclaw-admin/

# 构建整个项目
WORKDIR /app
# 使用 -pl 参数只构建 vipclaw-admin 模块及其依赖
# 添加 native profile 构建原生镜像
RUN mvn clean package -pl vipclaw-admin -am -P${EDITION},native -DskipTests -Dmaven.javadoc.skip=true -Dmaven.source.skip=true -B

# Stage 2: 使用 Alpine 运行原生可执行文件
FROM alpine:3.20

# 设置时区
ENV TZ=Asia/Shanghai
RUN apk add --no-cache tzdata && \
    cp /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone

# 创建非 root 用户
RUN addgroup -S vipclaw && \
    adduser -S vipclaw -G vipclaw

WORKDIR /app

# 从构建阶段复制原生可执行文件
COPY --from=builder /app/vipclaw-admin/target/vipclaw-admin-*-native app

# 创建日志目录
RUN mkdir -p /app/logs && chown -R vipclaw:vipclaw /app

# 切换到非 root 用户
USER vipclaw

# 暴露端口
EXPOSE 8080

# 健康检查
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/api/health || exit 1

# 启动应用
ENTRYPOINT ["./app"]

# 元数据
LABEL maintainer="vipamp"
LABEL version="1.0.0"
LABEL description="VIPClaw Admin Backend Native - ${EDITION} Edition"
LABEL edition="${EDITION}"