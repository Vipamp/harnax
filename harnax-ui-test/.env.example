# ── 被测环境(前后端需已启动) ──
BASE_URL=http://localhost:8000
TEST_USERNAME=admin
# 明文密码;前端会做 SHA-256 后提交
TEST_PASSWORD=admin123
# 万能验证码,必须与 harnax-admin 的 CAPTCHA_TEST_MASTER_CODE 环境变量一致
# (admin 侧默认关闭;测试环境启动时: export CAPTCHA_TEST_MASTER_CODE=UI_TEST_2026)
CAPTCHA_MASTER_CODE=UI_TEST_2026

# ── LLM(仅 npm run gen 生成用例时使用;日常 npm test 不消耗) ──
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat

# ── 运行参数 ──
HEADLESS=true
# 看板端口
DASHBOARD_PORT=4600
