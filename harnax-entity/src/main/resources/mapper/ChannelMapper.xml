<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agnetix.harnax.mapper.ChannelMapper">

    <!-- Result Map -->
    <resultMap id="ChannelResultMap" type="com.agnetix.harnax.entity.Channel">
        <id     column="id"                 property="id"/>
        <result column="tenant_id"          property="tenantId"/>
        <result column="name"               property="name"/>
        <result column="type"               property="type"/>
        <result column="agent_id"           property="agentId"/>
        <result column="callback_key"       property="callbackKey"/>
        <result column="session_id"         property="sessionId"/>
        <result column="communication_mode" property="communicationMode"/>
        <result column="permission_mode"  property="permissionMode"/>
        <result column="enable_think"     property="enableThink"/>
        <result column="enable_search"    property="enableSearch"/>
        <result column="enable_plan"      property="enablePlan"/>
        <result column="enabled"            property="enabled"/>
        <result column="config_json"        property="configJson"/>
        <result column="description"        property="description"/>
        <result column="creator"            property="creator"/>
        <result column="status"             property="status"/>
        <result column="active"             property="active"/>
        <result column="create_time"        property="createTime"/>
        <result column="update_time"        property="updateTime"/>
    </resultMap>

    <sql id="BaseColumnList">
        id, tenant_id, name, type, agent_id, callback_key, session_id,
        communication_mode, permission_mode, enable_think, enable_search, enable_plan,
        enabled, config_json, description,
        creator, status, active, create_time, update_time
    </sql>

    <!-- ==================== Basic CRUD Methods ==================== -->

    <!-- selectById filters on `active = 1` like every other read in this file. Without it a
         soft-deleted channel stayed readable by id, so `ChannelServiceImpl.getChannel`,
         `updateChannel` and `toggleChannelStatus` kept serving and editing a row the admin had
         already deleted, while `selectChannelList` no longer showed it -->
    <select id="selectById" resultMap="ChannelResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM channel
        WHERE id = #{id} AND active = 1
        LIMIT 1
    </select>

    <update id="deleteById">
        UPDATE channel SET active = 0, update_time = NOW() WHERE id = #{id}
    </update>

    <select id="selectByCallbackKey" resultMap="ChannelResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM channel
        WHERE callback_key = #{callbackKey} AND active = 1
        LIMIT 1
    </select>

    <select id="selectBySessionId" resultMap="ChannelResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM channel
        WHERE session_id = #{sessionId} AND active = 1
        LIMIT 1
    </select>

    <!-- Ownership answer: the three columns the router's cross-tenant check compares, and no more. -->
    <resultMap id="ChannelOwnerResultMap" type="com.agnetix.harnax.entity.dto.ChannelSessionOwner">
        <result column="session_id" property="sessionId"/>
        <result column="tenant_id"  property="tenantId"/>
        <result column="agent_id"   property="agentId"/>
    </resultMap>

    <!--
        Deliberately without the `active = 1` filter the statement above carries, and selectBySessionId
        is not relaxed instead because the configuration callers there must keep treating a deleted
        channel as gone. `deleteById` is a soft delete: the row keeps its tenant_id after the channel is
        deleted, and deleting a channel cleans up neither its session nor its sandbox. So an
        active-filtered ownership read would answer "no owner" for exactly the rows that still have a
        live session behind them, and the router passes an owner it cannot resolve — which would make
        deleting a channel a way to erase accountability for reading it. A row has an owner whatever its
        active flag says; no row at all is the only case that answers nothing, and `chn-` ids are minted
        and inserted together with their channel, so that case is an id this admin never issued.
    -->
    <select id="selectOwnerBySessionId" resultMap="ChannelOwnerResultMap">
        SELECT session_id, tenant_id, agent_id
        FROM channel
        WHERE session_id = #{sessionId}
        LIMIT 1
    </select>

    <select id="selectByAgentId" resultMap="ChannelResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM channel
        WHERE agent_id = #{agentId} AND active = 1
        ORDER BY id ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO channel (
            tenant_id, name, type, agent_id, callback_key, session_id,
            communication_mode, permission_mode, enable_think, enable_search, enable_plan,
            enabled, config_json, description,
            creator, status, active, create_time, update_time
        ) VALUES (
            #{tenantId}, #{name}, #{type}, #{agentId}, #{callbackKey}, #{sessionId},
            #{communicationMode}, #{permissionMode}, #{enableThink}, #{enableSearch}, #{enablePlan},
            #{enabled}, #{configJson}, #{description},
            #{creator}, #{status}, #{active}, #{createTime}, #{updateTime}
        )
    </insert>

    <update id="updateById">
        UPDATE channel SET
            tenant_id          = #{tenantId},
            name               = #{name},
            type               = #{type},
            agent_id           = #{agentId},
            callback_key       = #{callbackKey},
            communication_mode = #{communicationMode},
            permission_mode    = #{permissionMode},
            enable_think       = #{enableThink},
            enable_search      = #{enableSearch},
            enable_plan        = #{enablePlan},
            enabled            = #{enabled},
            config_json        = #{configJson},
            description        = #{description},
            status             = #{status},
            active             = #{active},
            update_time        = #{updateTime}
        WHERE id = #{id}
    </update>

    <update id="updateStatus">
        UPDATE channel SET status = #{status}, update_time = NOW() WHERE id = #{id} AND active = 1
    </update>

    <!-- ==================== Custom Query Methods ==================== -->

    <select id="selectChannelList" resultMap="ChannelResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM channel
        WHERE active = 1
        <if test='keyword != null and keyword != ""'>
            AND (name LIKE CONCAT('%', #{keyword}, '%')
                 OR description LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test='type != null and type != ""'>
            AND type = #{type}
        </if>
        <if test='status != null'>
            AND status = #{status}
        </if>
        ORDER BY create_time DESC
    </select>

    <select id="selectAutoStartChannels" resultMap="ChannelResultMap">
        SELECT <include refid="BaseColumnList"/>
        FROM channel
        WHERE enabled = 1 AND status = 1 AND active = 1
        ORDER BY id ASC
    </select>

</mapper>
