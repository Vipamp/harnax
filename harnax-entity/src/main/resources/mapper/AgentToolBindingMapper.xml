<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agnetix.harnax.mapper.AgentToolBindingMapper">

    <resultMap id="AgentToolBindingResultMap" type="com.agnetix.harnax.entity.AgentToolBinding">
        <id column="id" property="id"/>
        <result column="agent_id" property="agentId"/>
        <result column="tool_id" property="toolId"/>
        <result column="need_confirm" property="needConfirm"/>
        <result column="env_bindings" property="envBindings"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByAgentId" resultMap="AgentToolBindingResultMap">
        SELECT * FROM agent_tool_binding WHERE agent_id = #{agentId} ORDER BY id
    </select>

    <insert id="batchInsert">
        INSERT INTO agent_tool_binding (agent_id, tool_id, need_confirm, env_bindings, create_time, update_time)
        VALUES
        <foreach collection="list" item="b" separator=",">
            (#{b.agentId}, #{b.toolId}, #{b.needConfirm}, #{b.envBindings}, #{b.createTime}, #{b.updateTime})
        </foreach>
    </insert>

    <delete id="deleteByAgentId">
        DELETE FROM agent_tool_binding WHERE agent_id = #{agentId}
    </delete>

    <delete id="deleteByToolIds">
        DELETE FROM agent_tool_binding WHERE tool_id IN
        <foreach collection="toolIds" item="toolId" open="(" separator="," close=")">
            #{toolId}
        </foreach>
    </delete>

</mapper>
