<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agnetix.harnax.mapper.AgentTaskLogMapper">

    <resultMap id="AgentTaskLogResultMap" type="com.agnetix.harnax.entity.AgentTaskLog">
        <id column="id" property="id"/>
        <result column="task_id" property="taskId"/>
        <result column="task_name" property="taskName"/>
        <result column="prompt" property="prompt"/>
        <result column="response" property="response"/>
        <result column="session_id" property="sessionId"/>
        <result column="status" property="status"/>
        <result column="error_info" property="errorInfo"/>
        <result column="token_usage" property="tokenUsage"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="duration_ms" property="durationMs"/>
        <result column="creator" property="creator"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectById" resultMap="AgentTaskLogResultMap">
        SELECT * FROM agent_task_log WHERE id = #{id}
    </select>

    <!--
      The gated counterpart of selectById, on the same visibility rule as selectLogList (active, and
      either public or created by the caller). Stopping an execution is a *write*, and a log id leaks
      easily (URLs, exports, the log table on screen), so without this filter anyone who learned an id
      could interrupt somebody else's run. A row that exists but is not the caller's answers exactly
      like a missing one, so the endpoint cannot be probed for other people's log ids.

      Deliberately no tenant predicate: this has to stay as wide as the task reads it mirrors
      (AgentTaskMapper.xml has none either), and agent_task.tenant_id is only a snapshot of the tenant
      that was active when the task was created. Narrowing here would be stricter than the task list,
      and an owner who simply switched tenants would lose sight of their own executions and be unable
      to stop them.
    -->
    <select id="selectVisibleById" resultMap="AgentTaskLogResultMap">
        SELECT l.* FROM agent_task_log l
        JOIN agent_task t ON t.id = l.task_id
            AND t.active = 1
            AND (t.is_public = 1 OR t.creator = #{currentUsername})
        WHERE l.id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO agent_task_log (
            task_id, task_name, prompt, response, session_id,
            status, error_info, token_usage,
            start_time, end_time, duration_ms,
            creator, create_time
        ) VALUES (
            #{taskId}, #{taskName}, #{prompt}, #{response}, #{sessionId},
            #{status}, #{errorInfo}, #{tokenUsage},
            #{startTime}, #{endTime}, #{durationMs},
            #{creator}, #{createTime}
        )
    </insert>

    <!--
      3 -> 4 (running -> stopping). Any node may service a stop request; the row is the only shared
      state that matters. 0 rows means the execution already ended on its own.
    -->
    <update id="markStopping">
        UPDATE agent_task_log SET status = 4, error_info = #{errorInfo}
        WHERE id = #{id} AND status = 3
    </update>

    <!--
      Normal close-out of an execution. Guarded on status = 3 rather than 3 OR 4: a row that moved to
      4 was stopped by the user, and the execution thread must report that through finalizeStopped
      instead of overwriting the stop with its own result.
    -->
    <update id="finishExecution">
        UPDATE agent_task_log SET
            response = #{response},
            status = #{status},
            error_info = #{errorInfo},
            token_usage = #{tokenUsage},
            end_time = #{endTime},
            duration_ms = #{durationMs}
        WHERE id = #{id} AND status = 3
    </update>

    <!-- 4 -> 5 (stopping -> stopped), written by the execution thread once it notices the stop. -->
    <update id="finalizeStopped">
        UPDATE agent_task_log SET
            response = #{response},
            status = 5,
            error_info = #{errorInfo},
            token_usage = #{tokenUsage},
            end_time = #{endTime},
            duration_ms = #{durationMs}
        WHERE id = #{id} AND status = 4
    </update>

    <!--
      2 -> {0,1}: the reaper guessed, and the execution then proved otherwise by returning a result.
      Restricted to status 2 so this can never undo a user stop (4/5) or a real failure already
      written (0/1). The marker in error_info is what tells the two kinds of 0/1 apart later.
    -->
    <update id="reclaimExpired" parameterType="com.agnetix.harnax.entity.AgentTaskLog">
        UPDATE agent_task_log SET
            response = #{response},
            status = #{status},
            error_info = CONCAT(IFNULL(#{errorInfo}, ''), ' (completed after auto-expiry)'),
            end_time = #{endTime},
            duration_ms = #{durationMs}
        WHERE id = #{id} AND status = 2
    </update>

    <!--
      Reads are gated through the owning task, with the same visibility rule as
      AgentTaskMapper.selectTaskList: active, and either public or created by the caller. The log row
      repeats prompt/response/error_info verbatim, so filtering on the log columns alone let anyone who
      guessed a task id read another user's task traffic. The join also drops logs whose task was deleted
      (active = 0), which the task list no longer shows either.

      The creator/public rule is the whole gate; no tenant predicate belongs here. tenant_id is a
      creation-time snapshot and the task reads carry no tenant condition, so narrowing by tenant would
      show a task in the list while its own execution logs came back empty.
    -->
    <select id="selectLogList" resultMap="AgentTaskLogResultMap">
        SELECT l.* FROM agent_task_log l
        JOIN agent_task t ON t.id = l.task_id
            AND t.active = 1
            AND (t.is_public = 1 OR t.creator = #{currentUsername})
        WHERE 1=1
        <if test="taskId != null">
            AND l.task_id = #{taskId}
        </if>
        <if test="taskName != null and taskName != ''">
            AND l.task_name LIKE CONCAT('%', #{taskName}, '%')
        </if>
        <if test="status != null">
            AND l.status = #{status}
        </if>
        <if test="startTimeFrom != null and startTimeFrom != ''">
            AND l.start_time &gt;= #{startTimeFrom}
        </if>
        <if test="startTimeTo != null and startTimeTo != ''">
            AND l.start_time &lt;= #{startTimeTo}
        </if>
        <if test="keyword != null and keyword != ''">
            AND (l.prompt LIKE CONCAT('%', #{keyword}, '%')
                 OR l.response LIKE CONCAT('%', #{keyword}, '%')
                 OR l.error_info LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        ORDER BY l.create_time DESC
    </select>

    <select id="selectRunningByTaskId" resultMap="AgentTaskLogResultMap">
        SELECT * FROM agent_task_log WHERE task_id = #{taskId} AND status IN (3, 4) ORDER BY create_time DESC
    </select>

    <!--
      Reclaims executions that outlived their own task's timeout — the rows a node leaves behind when
      it dies mid-task. Judged per row against agent_task.timeout_seconds, falling back to the caller's
      default where a task stored 0 or NULL.

      The deadline is 1.5x that timeout, not the timeout itself: a run that is merely queued behind
      another one in agent-service is still alive and would otherwise be judged a zombie exactly when
      the user's own timeout fires. The message still reports the task's own timeout, because that is
      the value the user configured and the one they can act on.
    -->
    <update id="expireStale">
        UPDATE agent_task_log l
        JOIN agent_task t ON t.id = l.task_id
        SET l.status = 2,
            l.end_time = NOW(),
            l.error_info = CONCAT('Auto-expired: no completion within ',
                IFNULL(NULLIF(t.timeout_seconds, 0), #{defaultTimeoutSeconds}), 's (likely service restart)'),
            l.duration_ms = TIMESTAMPDIFF(SECOND, COALESCE(l.start_time, l.create_time), NOW()) * 1000
        WHERE l.status IN (3, 4)
          AND COALESCE(l.start_time, l.create_time) &lt;
              DATE_SUB(NOW(), INTERVAL CEIL(IFNULL(NULLIF(t.timeout_seconds, 0), #{defaultTimeoutSeconds}) * 1.5) SECOND)
    </update>

    <!--
      Retention sweep, keyed on create_time (indexed) rather than start_time: a run that never got a
      start time would otherwise stay here forever. The scheduler's housekeeping job is the only caller,
      and until it existed no statement in this file ever removed a row.

      status NOT IN (3, 4) keeps the same guard every other write carries: a row that still reads live
      belongs to an execution someone may still report on, age is no argument against that.
    -->
    <delete id="deleteOldLogs">
        DELETE FROM agent_task_log
        WHERE create_time &lt; #{beforeTime}
          AND status NOT IN (3, 4)
    </delete>

</mapper>
