<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agnetix.harnax.mapper.CliMapper">

    <resultMap id="CliResultMap" type="com.agnetix.harnax.entity.Cli">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="description" property="description"/>
        <result column="version" property="version"/>
        <result column="check_command" property="checkCommand"/>
        <result column="skill_id" property="skillId"/>
        <result column="package_digest" property="packageDigest"/>
        <result column="payload_digest" property="payloadDigest"/>
        <result column="package_object" property="packageObject"/>
        <result column="deps_apt" property="depsApt"/>
        <result column="runtime_env" property="runtimeEnv"/>
        <result column="env_params" property="envParams"/>
        <result column="status" property="status"/>
        <result column="active" property="active"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectById" resultMap="CliResultMap">
        SELECT * FROM cli WHERE id = #{id} AND active = 1 LIMIT 1
    </select>

    <select id="selectByIds" resultMap="CliResultMap">
        SELECT * FROM cli WHERE active = 1 AND id IN
        <foreach collection="ids" item="cliId" open="(" separator="," close=")">
            #{cliId}
        </foreach>
    </select>

    <select id="selectByName" resultMap="CliResultMap">
        SELECT * FROM cli WHERE name = #{name} LIMIT 1
    </select>

    <!--
        Same row selectByName looks up, locked for the calling transaction. The WHERE clause is a copy on
        purpose: the lookup must not answer differently depending on whether the caller asked for a lock.
    -->
    <select id="selectByNameForUpdate" resultMap="CliResultMap">
        SELECT * FROM cli WHERE name = #{name} LIMIT 1 FOR UPDATE
    </select>

    <!-- selectBySkillIds: packages shipping one of the given skills -->
    <select id="selectBySkillIds" resultMap="CliResultMap">
        SELECT * FROM cli WHERE active = 1 AND skill_id IN
        <foreach collection="skillIds" item="skillId" open="(" separator="," close=")">
            #{skillId}
        </foreach>
    </select>

    <select id="selectCliList" resultMap="CliResultMap">
        SELECT * FROM cli
        WHERE active = 1
        <if test='name != null and name != ""'>
            AND name LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test='status != null'>
            AND status = #{status}
        </if>
        ORDER BY name ASC
    </select>

    <!--
        Package rows are registrar-owned, so this overwrites every field the manifest declares.
        `status` is the deliberate exception: it is the operator's kill switch (design D9), and
        rewriting it to 1 here would silently re-enable a CLI the day someone restarts admin.
        `active = 1` needs no exception: the registrar is the only writer and a row it holds is live by
        definition. V38 and V42 retired the pre-package leftovers under a `#retired-<id>` name (V38 for
        the live ones, V42 for the ones that were already soft-deleted), so looking a package name up
        never lands on a soft-deleted row in the first place.
    -->
    <insert id="upsertCliPackage">
        INSERT INTO cli (
            name, description, version, check_command, skill_id, package_digest, payload_digest,
            package_object, deps_apt, runtime_env, env_params, status, active, create_time, update_time
        ) VALUES (
            #{name}, #{description}, #{version}, #{checkCommand}, #{skillId}, #{packageDigest}, #{payloadDigest},
            #{packageObject}, #{depsApt}, #{runtimeEnv}, #{envParams}, 1, 1, NOW(), NOW()
        )
        ON DUPLICATE KEY UPDATE
            description = VALUES(description),
            version = VALUES(version),
            check_command = VALUES(check_command),
            skill_id = VALUES(skill_id),
            package_digest = VALUES(package_digest),
            payload_digest = VALUES(payload_digest),
            package_object = VALUES(package_object),
            deps_apt = VALUES(deps_apt),
            runtime_env = VALUES(runtime_env),
            env_params = VALUES(env_params),
            active = 1,
            update_time = NOW()
    </insert>

    <update id="updateStatus">
        UPDATE cli SET status = #{status}, update_time = NOW() WHERE id = #{id} AND active = 1
    </update>

    <select id="selectAll" resultMap="CliResultMap">
        SELECT * FROM cli
    </select>

    <!--
        Hard delete for the prune path only. A package that left the directory is gone, and keeping
        an active = 0 row would block the name forever (uk_cli_name), so a re-added package could
        never come back. No guard here because the caller hands over only ids it proved it wrote:
        `pruneMissingPackages` starts from rows with a non-empty package_digest.
    -->
    <delete id="deleteByIds">
        DELETE FROM cli WHERE id IN
        <foreach collection="ids" item="cliId" open="(" separator="," close=")">
            #{cliId}
        </foreach>
    </delete>

</mapper>
