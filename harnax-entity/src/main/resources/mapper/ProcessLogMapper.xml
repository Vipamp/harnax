<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agnetix.harnax.mapper.ProcessLogMapper">

    <!-- Result Map -->
    <resultMap id="ProcessLogEntityResultMap" type="com.agnetix.harnax.entity.ProcessLogEntity">
        <id column="id" property="id"/>
        <result column="agent_id" property="agentId"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="agent_name" property="agentName"/>
        <result column="session_id" property="sessionId"/>
        <result column="message" property="message"/>
        <result column="log_type" property="logType"/>
        <result column="stack_trace" property="stackTrace"/>
        <result column="ts" property="ts"/>
    </resultMap>

    <!-- ==================== Basic CRUD Methods ==================== -->

    <!-- selectById -->
    <select id="selectById" resultMap="ProcessLogEntityResultMap">
        SELECT * FROM process_log WHERE id = #{id} LIMIT 1
    </select>

    <!-- deleteById: `process_log` has no active column, so a soft delete here would only fail -->
    <delete id="deleteById">
        DELETE FROM process_log WHERE id = #{id}
    </delete>

    <!-- insert: the only statement with a production caller (`ProcessLogAdaptorImpl`). `tenant_id` can
         only be written here — the runtime is where the tenant is known, and a row that arrives without
         one stays NULL and out of the tenant-scoped reads rather than being guessed at (V50). -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO process_log (
        agent_id, tenant_id, agent_name, session_id, message, log_type, stack_trace, ts
        ) VALUES (
        #{agentId}, #{tenantId}, #{agentName}, #{sessionId}, #{message}, #{logType}, #{stackTrace}, #{ts}
        )
    </insert>

    <!-- updateById: `tenant_id` is deliberately absent. Attribution records who ran, not a field an
         editor owns, so no update may move a row to another tenant. -->
    <update id="updateById">
        UPDATE process_log SET
        agent_id = #{agentId},
        agent_name = #{agentName},
        session_id = #{sessionId},
        message = #{message},
        log_type = #{logType},
        stack_trace = #{stackTrace},
        ts = #{ts}
        WHERE id = #{id}
    </update>

</mapper>
