<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agnetix.harnax.mapper.TeamSkillBindingMapper">

    <resultMap id="TeamSkillBindingResultMap" type="com.agnetix.harnax.entity.TeamSkillBinding">
        <id column="id" property="id"/>
        <result column="team_id" property="teamId"/>
        <result column="skill_id" property="skillId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByTeamId" resultMap="TeamSkillBindingResultMap">
        SELECT * FROM team_skill_binding WHERE team_id = #{teamId} ORDER BY id
    </select>

    <insert id="batchInsert">
        INSERT INTO team_skill_binding (team_id, skill_id, create_time, update_time)
        VALUES
        <foreach collection="list" item="b" separator=",">
            (#{b.teamId}, #{b.skillId}, #{b.createTime}, #{b.updateTime})
        </foreach>
    </insert>

    <delete id="deleteByTeamId">
        DELETE FROM team_skill_binding WHERE team_id = #{teamId}
    </delete>

    <select id="selectBoundSkillIds" resultType="java.lang.Long">
        SELECT DISTINCT skill_id FROM team_skill_binding
        WHERE skill_id IN
        <foreach collection="skillIds" item="skillId" open="(" separator="," close=")">
            #{skillId}
        </foreach>
    </select>

    <delete id="deleteBySkillIds">
        DELETE FROM team_skill_binding WHERE skill_id IN
        <foreach collection="skillIds" item="skillId" open="(" separator="," close=")">
            #{skillId}
        </foreach>
    </delete>

</mapper>
