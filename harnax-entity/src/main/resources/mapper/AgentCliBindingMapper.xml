<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agnetix.harnax.mapper.AgentCliBindingMapper">

    <resultMap id="AgentCliBindingResultMap" type="com.agnetix.harnax.entity.AgentCliBinding">
        <id column="id" property="id"/>
        <result column="agent_id" property="agentId"/>
        <result column="cli_id" property="cliId"/>
        <result column="env_bindings" property="envBindings"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByAgentId" resultMap="AgentCliBindingResultMap">
        SELECT * FROM agent_cli_binding WHERE agent_id = #{agentId} ORDER BY id
    </select>

    <!-- Every binding at once, for the CLI inventory the runtime's reclaim sweep reads -->
    <select id="selectAll" resultMap="AgentCliBindingResultMap">
        SELECT * FROM agent_cli_binding ORDER BY agent_id, id
    </select>

    <select id="selectByCliId" resultMap="AgentCliBindingResultMap">
        SELECT * FROM agent_cli_binding WHERE cli_id = #{cliId} ORDER BY id
    </select>

    <insert id="batchInsert">
        INSERT INTO agent_cli_binding (agent_id, cli_id, env_bindings, create_time, update_time)
        VALUES
        <foreach collection="list" item="b" separator=",">
            (#{b.agentId}, #{b.cliId}, #{b.envBindings}, #{b.createTime}, #{b.updateTime})
        </foreach>
    </insert>

    <delete id="deleteByAgentId">
        DELETE FROM agent_cli_binding WHERE agent_id = #{agentId}
    </delete>

    <delete id="deleteByCliIds">
        DELETE FROM agent_cli_binding WHERE cli_id IN
        <foreach collection="cliIds" item="cliId" open="(" separator="," close=")">
            #{cliId}
        </foreach>
    </delete>

</mapper>
