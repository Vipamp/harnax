<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agnetix.harnax.mapper.AgentSkillBindingMapper">

    <resultMap id="AgentSkillBindingResultMap" type="com.agnetix.harnax.entity.AgentSkillBinding">
        <id column="id" property="id"/>
        <result column="agent_id" property="agentId"/>
        <result column="skill_id" property="skillId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByAgentId" resultMap="AgentSkillBindingResultMap">
        SELECT id, agent_id, skill_id, create_time, update_time
        FROM agent_skill_binding WHERE agent_id = #{agentId} ORDER BY id
    </select>

    <insert id="batchInsert">
        INSERT INTO agent_skill_binding (agent_id, skill_id, create_time, update_time)
        VALUES
        <foreach collection="list" item="b" separator=",">
            (#{b.agentId}, #{b.skillId}, #{b.createTime}, #{b.updateTime})
        </foreach>
    </insert>

    <delete id="deleteByAgentId">
        DELETE FROM agent_skill_binding WHERE agent_id = #{agentId}
    </delete>

    <delete id="deleteBySkillIds">
        DELETE FROM agent_skill_binding WHERE skill_id IN
        <foreach collection="skillIds" item="skillId" open="(" separator="," close=")">
            #{skillId}
        </foreach>
    </delete>

    <resultMap id="SkillAgentBindingCountResultMap" type="com.agnetix.harnax.entity.dto.SkillAgentBindingCount">
        <result column="skill_id" property="skillId"/>
        <result column="agent_count" property="agentCount"/>
    </resultMap>

    <!-- selectAgentBindingCounts -->
    <select id="selectAgentBindingCounts" resultMap="SkillAgentBindingCountResultMap">
        <!-- DISTINCT stays after V33 put UNIQUE(agent_id, skill_id) on the table: a duplicate row
             would read as two agents, and the guard that refuses to disable the skill would then name
             a count nobody can see in the agent list. The entity test schema deliberately keeps the
             pre-V33 shape so that read is exercised -->
        SELECT skill_id, COUNT(DISTINCT agent_id) AS agent_count
        FROM agent_skill_binding
        WHERE skill_id IN
        <foreach collection="skillIds" item="skillId" open="(" separator="," close=")">
            #{skillId}
        </foreach>
        GROUP BY skill_id
    </select>

</mapper>
