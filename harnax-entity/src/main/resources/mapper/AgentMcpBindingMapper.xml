<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agnetix.harnax.mapper.AgentMcpBindingMapper">

    <resultMap id="AgentMcpBindingResultMap" type="com.agnetix.harnax.entity.AgentMcpBinding">
        <id column="id" property="id"/>
        <result column="agent_id" property="agentId"/>
        <result column="mcp_id" property="mcpId"/>
        <result column="env_bindings" property="envBindings"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByAgentId" resultMap="AgentMcpBindingResultMap">
        SELECT * FROM agent_mcp_binding WHERE agent_id = #{agentId} ORDER BY id
    </select>

    <insert id="batchInsert">
        INSERT INTO agent_mcp_binding (agent_id, mcp_id, env_bindings, create_time, update_time)
        VALUES
        <foreach collection="list" item="b" separator=",">
            (#{b.agentId}, #{b.mcpId}, #{b.envBindings}, #{b.createTime}, #{b.updateTime})
        </foreach>
    </insert>

    <delete id="deleteByAgentId">
        DELETE FROM agent_mcp_binding WHERE agent_id = #{agentId}
    </delete>

    <delete id="deleteByMcpId">
        DELETE FROM agent_mcp_binding WHERE mcp_id = #{mcpId}
    </delete>

</mapper>
