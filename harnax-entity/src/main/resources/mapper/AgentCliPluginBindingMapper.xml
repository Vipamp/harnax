<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agnetix.harnax.mapper.AgentCliPluginBindingMapper">

    <resultMap id="AgentCliPluginBindingResultMap" type="com.agnetix.harnax.entity.AgentCliPluginBinding">
        <id column="id" property="id"/>
        <result column="agent_id" property="agentId"/>
        <result column="plugin_id" property="pluginId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByAgentId" resultMap="AgentCliPluginBindingResultMap">
        SELECT * FROM agent_cli_plugin_binding WHERE agent_id = #{agentId} ORDER BY id
    </select>

    <insert id="batchInsert">
        INSERT INTO agent_cli_plugin_binding (agent_id, plugin_id, create_time, update_time)
        VALUES
        <foreach collection="list" item="b" separator=",">
            (#{b.agentId}, #{b.pluginId}, #{b.createTime}, #{b.updateTime})
        </foreach>
    </insert>

    <delete id="deleteByAgentId">
        DELETE FROM agent_cli_plugin_binding WHERE agent_id = #{agentId}
    </delete>

</mapper>
