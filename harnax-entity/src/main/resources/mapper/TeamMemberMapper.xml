<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agnetix.harnax.mapper.TeamMemberMapper">

    <resultMap id="TeamMemberResultMap" type="com.agnetix.harnax.entity.TeamMember">
        <id column="id" property="id"/>
        <result column="team_id" property="teamId"/>
        <result column="member_agent_id" property="memberAgentId"/>
        <result column="delegation_description" property="delegationDescription"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- Order by id: the member order a user assembled in the form is the order the lead is shown. -->
    <select id="selectByTeamId" resultMap="TeamMemberResultMap">
        SELECT * FROM team_member WHERE team_id = #{teamId} ORDER BY id
    </select>

    <select id="selectByMemberAgentId" resultMap="TeamMemberResultMap">
        SELECT * FROM team_member WHERE member_agent_id = #{agentId} ORDER BY id
    </select>

    <insert id="batchInsert">
        INSERT INTO team_member (team_id, member_agent_id, delegation_description, create_time, update_time)
        VALUES
        <foreach collection="list" item="m" separator=",">
            (#{m.teamId}, #{m.memberAgentId}, #{m.delegationDescription}, #{m.createTime}, #{m.updateTime})
        </foreach>
    </insert>

    <delete id="deleteByTeamId">
        DELETE FROM team_member WHERE team_id = #{teamId}
    </delete>

</mapper>
