<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.agnetix.harnax.mapper.AgentToolMapper">

    <!-- No tenant_id and no timeout_seconds: the table is platform-scoped (V40) and the tool-level
         timeout is gone with @ToolMeta(timeoutSeconds) — the whole-turn timeout is set at assembly. -->
    <resultMap id="AgentToolResultMap" type="com.agnetix.harnax.entity.AgentTool">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="display_name" property="displayName"/>
        <result column="display_name_zh" property="displayNameZh"/>
        <result column="description" property="description"/>
        <result column="bean_name" property="beanName"/>
        <result column="method_name" property="methodName"/>
        <result column="read_only" property="readOnly"/>
        <result column="need_confirm" property="needConfirm"/>
        <result column="is_required" property="isRequired"/>
        <result column="required_env_param_keys" property="requiredEnvParamKeys"/>
        <result column="status" property="status"/>
        <result column="creator" property="creator"/>
        <result column="active" property="active"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectById" resultMap="AgentToolResultMap">
        SELECT * FROM agent_tool WHERE id = #{id} AND active = 1 LIMIT 1
    </select>

    <!-- Batch load by id (agent spec delivery) -->
    <select id="selectByIds" resultMap="AgentToolResultMap">
        SELECT * FROM agent_tool WHERE active = 1 AND id IN
        <foreach collection="ids" item="toolId" open="(" separator="," close=")">
            #{toolId}
        </foreach>
    </select>

    <!-- The sync's identity lookup, so it must not be narrowed by `active`: a row the retired manual
         delete left at active = 0 still holds the name, and missing it would make the sync insert a
         second row under uk_agent_tool_name. The update revives such a row instead. -->
    <select id="selectByName" resultMap="AgentToolResultMap">
        SELECT * FROM agent_tool WHERE name = #{name} LIMIT 1
    </select>

    <select id="selectAgentToolList" resultMap="AgentToolResultMap">
        SELECT * FROM agent_tool
        WHERE active = 1
        <if test='keyword != null and keyword != ""'>
            AND (name LIKE CONCAT('%', #{keyword}, '%')
            OR display_name LIKE CONCAT('%', #{keyword}, '%')
            OR description LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        <if test='status != null'>
            AND status = #{status}
        </if>
        ORDER BY status DESC, update_time DESC
    </select>

    <!-- Agent config wizard: required tools are auto-injected, so only optional ones are selectable -->
    <select id="selectAvailableTools" resultMap="AgentToolResultMap">
        SELECT * FROM agent_tool WHERE status = 1 AND active = 1 AND is_required = 0 ORDER BY name
    </select>

    <!-- Every tool is code-owned and always enabled, so this needs no status filter -->
    <select id="selectBuiltinToolList" resultMap="AgentToolResultMap">
        SELECT * FROM agent_tool WHERE active = 1 ORDER BY name
    </select>

    <!-- Required tools: appended to every agent spec at delivery time, no binding row -->
    <select id="selectRequiredTools" resultMap="AgentToolResultMap">
        SELECT * FROM agent_tool
        WHERE is_required = 1 AND status = 1 AND active = 1
        ORDER BY id
    </select>

    <!-- Insert one declaration found for the first time. `status` and `active` are written literal:
         the sync is the only writer and every tool it declares is enabled and undeleted. -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO agent_tool (
            name, display_name, display_name_zh, description, bean_name, method_name,
            read_only, need_confirm, is_required, required_env_param_keys,
            status, creator, active, create_time, update_time
        ) VALUES (
            #{name}, #{displayName}, #{displayNameZh}, #{description}, #{beanName}, #{methodName},
            #{readOnly}, #{needConfirm}, #{isRequired}, #{requiredEnvParamKeys},
            1, 'SYSTEM', 1, NOW(), NOW()
        )
    </insert>

    <!-- Refresh a row the sync resolved by name. `name` is absent on purpose: the row was found by it,
         and a renamed declaration is a different tool that gets its own row (the old one is kept). -->
    <update id="updateById">
        UPDATE agent_tool
        SET display_name = #{displayName},
            display_name_zh = #{displayNameZh},
            description = #{description},
            bean_name = #{beanName},
            method_name = #{methodName},
            read_only = #{readOnly},
            need_confirm = #{needConfirm},
            is_required = #{isRequired},
            required_env_param_keys = #{requiredEnvParamKeys},
            status = 1,
            active = 1,
            update_time = NOW()
        WHERE id = #{id}
    </update>

</mapper>