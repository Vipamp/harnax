<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.agnetix</groupId>
        <artifactId>harnax</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>harnax-scheduler</artifactId>
    <packaging>jar</packaging>

    <name>harnax-scheduler</name>
    <description>Harnax Scheduler Service - Agent task scheduling and execution</description>

    <properties>
        <!--
            Skipped by default, on purpose. The *IT classes in src/test/kotlin/**/it need a Docker daemon,
            and a build box without one must skip them rather than fail red on MySQLContainer.start().
            Declaring the property here — and not only inside the integration-test profile below — is what
            makes the <skipITs>${skipITs}</skipITs> further down resolve to `true` for a plain `mvn verify`;
            left undefined it resolves to the literal string, which failsafe parses as false, and the reactor
            then dies for lack of Docker. Same shape as harnax-admin/pom.xml.
        -->
        <skipITs>true</skipITs>
    </properties>

    <dependencies>
        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Spring Boot Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Boot Quartz -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-quartz</artifactId>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- PageHelper: the task list endpoints page the same way admin's did -->
        <dependency>
            <groupId>com.github.pagehelper</groupId>
            <artifactId>pagehelper-spring-boot-starter</artifactId>
            <version>2.1.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.mybatis.spring.boot</groupId>
                    <artifactId>mybatis-spring-boot-starter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- MyBatis Spring Boot Starter -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>

        <!-- MySQL Driver -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway for Database Migration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Harnax Common (for ResultVo) -->
        <dependency>
            <groupId>com.agnetix</groupId>
            <artifactId>harnax-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Harnax Entity - Shared database entities and mappers -->
        <dependency>
            <groupId>com.agnetix</groupId>
            <artifactId>harnax-entity</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Harnax Auth - Internal service-to-service JWT authentication -->
        <dependency>
            <groupId>com.agnetix</groupId>
            <artifactId>harnax-auth</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Harnax Protocol (for ChatAgentRequest) -->
        <dependency>
            <groupId>com.agnetix</groupId>
            <artifactId>harnax-protocol</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Jackson 3.x Kotlin Module -->
        <dependency>
            <groupId>tools.jackson.module</groupId>
            <artifactId>jackson-module-kotlin</artifactId>
        </dependency>

        <!-- Kotlin -->
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-stdlib-jdk8</artifactId>
            <version>${kotlin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.kotlin</groupId>
            <artifactId>kotlin-test</artifactId>
            <version>${kotlin.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.mockito.kotlin</groupId>
            <artifactId>mockito-kotlin</artifactId>
            <version>5.4.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: the real MySQL 8 the cluster / reconcile / guard integration tests (*IT) run on.
             Only these two are on the call path — `MySQLContainer` comes from `mysql`, which brings `core`. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mysql</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
        <!-- Unused today, and kept on purpose: the plan asked for the same trio the other modules declare
             (harnax-entity/pom.xml), and `BaseSchedulerIT` starts its shared container in the companion `init`
             instead, so there is no `@Testcontainers` annotation to run and this extension has nothing to do.
             It becomes load-bearing the moment an IT switches to `@Testcontainers`/`@Container`. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <skip>false</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <version>${kotlin.version}</version>
                <executions>
                    <execution>
                        <id>compile</id>
                        <phase>process-sources</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <sourceDirs>
                                <sourceDir>src/main/kotlin</sourceDir>
                            </sourceDirs>
                        </configuration>
                    </execution>
                    <execution>
                        <id>test-compile</id>
                        <phase>process-test-sources</phase>
                        <goals>
                            <goal>test-compile</goal>
                        </goals>
                        <configuration>
                            <sourceDirs>
                                <sourceDir>src/test/kotlin</sourceDir>
                            </sourceDirs>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <jvmTarget>21</jvmTarget>
                    <args>
                        <arg>-Xjsr305=strict</arg>
                        <arg>-Xannotation-default-target=param-property</arg>
                    </args>
                    <compilerPlugins>
                        <plugin>spring</plugin>
                    </compilerPlugins>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-maven-allopen</artifactId>
                        <version>${kotlin.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
            <!--
                Unit test phase: the *IT classes belong to failsafe below.

                Two mechanisms, because the first one alone leaks. `<excludes>` keeps them out of a plain
                `mvn test`; measured here, though, it did not keep them out of `mvn test -Dtest=...` — with a
                -Dtest filter on the command line surefire no longer honoured the configured excludes, and the
                three ITs ran in the unit phase and failed the reactor for lack of a Docker daemon.
                `excludedGroups` is applied by the JUnit 5 provider whichever way the scan was configured, so
                with the tag on BaseSchedulerIT (it is `@Inherited`) the ITs stay out either way.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*IT.class</exclude>
                    </excludes>
                    <excludedGroups>integration</excludedGroups>
                </configuration>
            </plugin>
            <!--
                Integration tests: Testcontainers MySQL, behind -Pintegration-test. `skipITs` is the
                module property declared at the top of this file, true unless that profile is active.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <skipITs>${skipITs}</skipITs>
                    <includes>
                        <include>**/*IT.class</include>
                    </includes>
                    <!--
                        The module's own classes, back on the fork's classpath by hand. `repackage` runs in
                        the same session and *before* failsafe, and because this module's fat jar has no
                        classifier it replaces target/harnax-scheduler-1.0.0-SNAPSHOT.jar; Maven then lists
                        that jar — not target/classes — on the test classpath, and a Boot fat jar keeps the
                        module's classes under BOOT-INF/classes where a plain classloader cannot see them.
                        Failsafe died during discovery with `NoClassDefFoundError:
                        com/agnetix/harnax/scheduler/health/SchedulerStatus`. `harnax-admin` sidesteps this
                        by giving its fat jar an `exec` classifier, which is a deployment change and not
                        this task's to make; this puts the output directory back for the IT fork only.
                    -->
                    <additionalClasspathElements>
                        <additionalClasspathElement>${project.build.outputDirectory}</additionalClasspathElement>
                    </additionalClasspathElements>
                    <!--
                        The fork's clock has to be the container's clock. Testcontainers' MySQL runs UTC, while
                        `expireStale` and `reclaimExpired` compare a DATETIME written from Java
                        (`LocalDateTime.now()`, which Connector/J sends literally, without conversion) against the
                        server's `NOW()`. On a +08:00 machine every seeded "old" row therefore landed eight hours
                        in the future and the sweeps reclaimed nothing: measured as
                        `at least two stale rows should be reclaimed, got 0`. Pinning the fork to UTC makes the
                        two clocks the same clock without depending on the developer's zone — the deployment that
                        actually runs pins both sides to Asia/Shanghai instead (compose `TZ` plus
                        `serverTimezone` in the JDBC URL).
                    -->
                    <argLine>-Duser.timezone=UTC</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Run the integration tests (needs a Docker daemon): mvn -Pintegration-test verify -pl harnax-scheduler -->
        <profile>
            <id>integration-test</id>
            <properties>
                <skipITs>false</skipITs>
            </properties>
        </profile>
    </profiles>
</project>
