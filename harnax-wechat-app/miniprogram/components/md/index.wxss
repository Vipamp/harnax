/* components/md/index.wxss */
.md {
  display: block;
}
.md-rich {
  display: block;
  font-size: 30rpx;
  color: #1D2129;
  line-height: 1.7;
  word-break: break-word;
}

/* 代码块 */
.md-code {
  margin: 16rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #1D2129;
}
.md-code__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 22rpx;
  background: #2A2E37;
}
.md-code__lang {
  font-size: 22rpx;
  color: #86909C;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}
.md-code__copy {
  font-size: 24rpx;
  color: #A9B0C0;
}
.md-code__copy:active {
  color: #FFFFFF;
}
.md-code__scroll {
  width: 100%;
}
.md-code__text {
  display: block;
  padding: 22rpx;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 24rpx;
  line-height: 1.6;
  color: #E5E6EB;
  white-space: pre;
}
