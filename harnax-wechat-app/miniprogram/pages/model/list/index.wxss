/* ---- Model List — Modern Minimal ---- */
.m-card {
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--border-color);
}
.m-card:active { background: #F7F8FA; }
.m-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.m-card__name {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
}
.m-card__tag {
  display: inline-block;
  font-size: 22rpx;
  color: #4F46E5;
  background: #EEF2FF;
  border-radius: var(--radius-full);
  padding: 4rpx 18rpx;
  margin-bottom: 10rpx;
  font-weight: 500;
}
.m-card__sub {
  display: block;
  font-size: 26rpx;
  color: #86909C;
  margin-bottom: 16rpx;
  word-break: break-all;
}
.m-card__caps {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.cap {
  font-size: 22rpx;
  color: #00A870;
  background: #E8F8F2;
  border-radius: var(--radius-full);
  padding: 4rpx 16rpx;
  font-weight: 500;
}
.m-card__actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F2F3F5;
}
.m-card__btn {
  font-size: 26rpx;
  color: #4F46E5;
  padding: 8rpx 24rpx;
  border: 1rpx solid #E0E7FF;
  border-radius: var(--radius-full);
  font-weight: 500;
}
.m-card__btn--danger {
  color: #E34D59;
  border-color: #FDECEE;
}
