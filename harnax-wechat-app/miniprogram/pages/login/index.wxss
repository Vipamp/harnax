/* ---- Login — Modern Minimal ---- */
.login {
  min-height: 100vh;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 48rpx;
  box-sizing: border-box;
  background: #F7F8FA;
}

.login__header {
  position: relative;
  z-index: 1;
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.login__logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: #4F46E5;
  color: #FFFFFF;
  font-size: 60rpx;
  font-weight: 700;
  text-align: center;
  line-height: 120rpx;
  letter-spacing: -0.03em;
}

.login__brand {
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #1D2129;
  letter-spacing: -0.02em;
}

.login__slogan {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #86909C;
  letter-spacing: 0.04em;
  font-weight: 500;
}

/* 表单卡 */
.login__card {
  position: relative;
  z-index: 1;
  width: 100%;
  margin-top: 64rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #F0F0F0;
}

.login__field {
  margin-bottom: 28rpx;
}

.login__label {
  display: block;
  font-size: 24rpx;
  color: #86909C;
  margin-bottom: 14rpx;
  font-weight: 500;
}

.login__input-wrap {
  display: flex;
  align-items: center;
  height: 92rpx;
  padding: 0 28rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  border: 1rpx solid #F0F0F0;
}

.login__input {
  flex: 1;
  font-size: 30rpx;
  color: #1D2129;
}

.login__ph {
  color: #C9CDD4;
}

.login__eye {
  font-size: 32rpx;
  padding-left: 16rpx;
  color: #C9CDD4;
}

.login__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.login__adv-toggle {
  font-size: 24rpx;
  color: #4F46E5;
  font-weight: 600;
}

.login__advanced {
  margin-bottom: 24rpx;
}

.login__hint {
  font-size: 22rpx;
  color: #C9CDD4;
  margin-top: 10rpx;
  display: block;
}

.login__remember {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #86909C;
}

.login__checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #C9CDD4;
  border-radius: 8rpx;
  margin-right: 12rpx;
  text-align: center;
  line-height: 36rpx;
  font-size: 22rpx;
  color: #ffffff;
}

.login__checkbox--on {
  background: #4F46E5;
  border-color: transparent;
}

/* 登录按钮 */
.login__btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: #4F46E5;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  letter-spacing: 0.05em;
}

.login__btn--loading {
  opacity: 0.7;
}

.login__btn::after {
  border: none;
}

.login__footer {
  position: relative;
  z-index: 1;
  margin-top: auto;
  padding: 48rpx 0;
  font-size: 22rpx;
  color: #C9CDD4;
  letter-spacing: 0.04em;
}
