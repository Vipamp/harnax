/* ---- Task Log — Modern Minimal ---- */
.log-card {
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--border-color);
}
.log-card__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.log-card__time { font-size: 28rpx; color: #1D2129; font-weight: 600; }
.log-card__meta { display: flex; gap: 24rpx; }
.log-card__meta-item { font-size: 24rpx; color: #86909C; font-weight: 500; }
.log-card__hint { margin-top: 14rpx; font-size: 24rpx; color: #C9CDD4; }
.log-card__section { margin-top: 20rpx; }
.log-card__label { font-size: 22rpx; color: #86909C; margin-bottom: 10rpx; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
.log-card__label--error { color: #E34D59; }
.log-card__text {
  font-size: 26rpx; color: #4E5969; line-height: 1.7;
  white-space: pre-wrap; word-break: break-word;
  background: #F7F8FA; border-radius: var(--radius-md); padding: 18rpx;
  border: 1rpx solid #F0F0F0;
}
.log-card__text--error { background: #FDECEE; color: #E34D59; border-color: #FDECEE; }
