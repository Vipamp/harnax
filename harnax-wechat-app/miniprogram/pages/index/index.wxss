/* ---- Dashboard — Modern Minimal ---- */
.dashboard {
  padding: 28rpx 0 48rpx;
}

/* 浅色横幅 */
.banner {
  position: relative;
  margin: 0 28rpx 28rpx;
  padding: 40rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #F0F0F0;
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
}

.banner__row {
  display: flex;
  align-items: center;
}

.banner__avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 20rpx;
  background: #EEF2FF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
}

.banner__info {
  display: flex;
  flex-direction: column;
}

.banner__hi {
  font-size: 24rpx;
  color: #86909C;
  font-weight: 500;
}

.banner__name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D2129;
  margin-top: 6rpx;
  letter-spacing: -0.02em;
}

.banner__desc {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #86909C;
}

.banner__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.banner__tag {
  padding: 8rpx 22rpx;
  background: #F2F3F5;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  color: #86909C;
  font-weight: 500;
}

/* 统计卡片 */
.stats {
  display: flex;
  flex-wrap: wrap;
  padding: 0 16rpx;
}

.stat {
  box-sizing: border-box;
  width: calc(50% - 24rpx);
  margin: 12rpx;
  padding: 32rpx 28rpx;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #F0F0F0;
}

.stat__icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat__value {
  font-size: 52rpx;
  font-weight: 700;
  color: #1D2129;
  margin-top: 20rpx;
  letter-spacing: -0.02em;
}

.stat__label {
  font-size: 24rpx;
  color: #86909C;
  margin-top: 6rpx;
  font-weight: 500;
}

/* 快捷入口 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
  margin: 32rpx 36rpx 12rpx;
}

.quick {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 28rpx;
}

.quick__item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.quick__icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.quick__label {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #86909C;
  font-weight: 500;
}
