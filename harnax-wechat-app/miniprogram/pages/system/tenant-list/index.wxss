/* ---- Tenant List — Modern Minimal ---- */
.t-card {
  display: flex;
  align-items: flex-start;
  background: #FFFFFF;
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow);
  border: 1rpx solid var(--border-color);
}
.t-card:active { background: #F7F8FA; }
.t-card__icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, #14B8A6, #0FA968);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.t-card__body { flex: 1; min-width: 0; }
.t-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.t-card__title { display: flex; flex-direction: column; min-width: 0; }
.t-card__name { font-size: 32rpx; font-weight: 600; color: #1D2129; }
.t-card__code { font-size: 22rpx; color: #86909C; margin-top: 4rpx; font-family: 'SF Mono', monospace; }
.t-card__desc { display: block; font-size: 26rpx; color: #86909C; }

/* 弹层 */
.mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(29, 33, 41, 0.5); z-index: 100;
  display: flex; align-items: flex-end;
}
.sheet {
  background: #fff; border-radius: 28rpx 28rpx 0 0;
  width: 100%; max-height: 70vh; overflow-y: auto;
  padding: 36rpx; padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
}
.sheet__head {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 28rpx;
}
.sheet__title { font-size: 32rpx; font-weight: 600; color: #1D2129; }
.sheet__close { font-size: 36rpx; color: #86909C; padding: 0 8rpx; }
.sheet__empty { text-align: center; padding: 40rpx 0; color: #86909C; font-size: 28rpx; }
.sheet__item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 22rpx 0; border-bottom: 1rpx solid #F2F3F5;
}
.sheet__item:last-child { border-bottom: none; }
.sheet__item-info { display: flex; align-items: center; gap: 14rpx; flex: 1; }
.sheet__item-name { font-size: 28rpx; color: #1D2129; font-weight: 500; }
.sheet__item-role {
  font-size: 22rpx; color: #4F46E5; background: #EEF2FF;
  border-radius: var(--radius-full); padding: 4rpx 16rpx; font-weight: 500;
}
.sheet__item-btn {
  font-size: 26rpx; color: #E34D59; padding: 6rpx 20rpx;
  border: 1rpx solid #FDECEE; border-radius: var(--radius-full); font-weight: 500;
}
